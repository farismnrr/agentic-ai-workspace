{
  "name": "agentic-ai-workspace-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint src vite.config.ts eslint.config.ts --max-warnings 0",
