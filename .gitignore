# Logs and temporary files
*.log
*.tmp
.tmp/
tmp/

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Loose design exploration (the logo ships as LogoMark.svelte and web/public icons)
assets/Minimal_logo_mark_*.jpg

# Local runtime data (SQLite database, signing key)
data/
preview-data/
local-build/
*.pem
*.key
id_rsa*
# Local non-Go tooling caches (do not exclude source or migrations)
__pycache__/
.venv/
