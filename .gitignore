# Runtime configuration
.env
.env.*
!.env.example

# Go build output
bin/
/agentic-ai-workspace
*.exe
*.out
*.test
coverage.out

# Frontend dependencies, caches and test artifacts
node_modules/
web/.vite/
web/.svelte-check/
web/coverage/
web/test-results/
web/playwright-report/

# Generated embedded SPA output
internal/platform/webassets/dist/*
